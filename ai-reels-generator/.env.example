# --- AI (Claude picks the topic, writes the script, and reviews the video) ---
# auto = use Claude Code on this computer if installed (your login, no API key),
#        otherwise the API key below.
REEL_AI_BACKEND=auto
# Only needed for the "api" backend (and for GitHub Actions).
ANTHROPIC_API_KEY=
# Optional model override. Empty = Claude Code's default / claude-opus-5 on the API.
CLAUDE_MODEL=

# Optional: free key from https://www.pexels.com/api/ for real stock footage.
# Without it, videos use animated gradient backgrounds.
PEXELS_API_KEY=

# Optional: get the finished video + caption on Telegram.
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Content settings
REEL_GEO=IN                 # Google Trends country (IN, US, GB, ...)
REEL_LANGUAGE=English       # narration language (English, Hindi, ...)
REEL_VOICE=en-US-AndrewNeural   # Hindi: hi-IN-MadhurNeural / hi-IN-SwaraNeural
REEL_NICHE=                 # optional, e.g. "tech and AI", "finance", "facts"
REEL_SECONDS=40             # target length

# --- Automatic quality check ---
REEL_MAX_ATTEMPTS=3         # regenerate up to this many times if a video fails review

# --- Local app (start.bat / start.sh, or: python -m reelgen serve) ---
REEL_PORT=8765
REEL_APP_PIN=               # set a PIN so only you can use the app on your Wi-Fi
REEL_SCHEDULE=              # e.g. 08:30 to make one video every day (can also set in the app)
