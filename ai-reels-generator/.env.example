# Required: Claude writes the script and picks the trending topic.
ANTHROPIC_API_KEY=
# Model used for topic choice + script (default claude-opus-5).
CLAUDE_MODEL=claude-opus-5

# Optional: free key from https://www.pexels.com/api/ for real stock footage.
# Without it, videos use animated gradient backgrounds.
PEXELS_API_KEY=

# Optional: get the finished video + caption on Telegram.
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Content settings
REEL_GEO=IN                 # Google Trends country (IN, US, GB, ...)
REEL_LANGUAGE=English       # narration language (English, Hindi, ...)
REEL_VOICE=en-US-AndrewNeural   # Hindi: hi-IN-MadhurNeural / hi-IN-SwaraNeural
REEL_NICHE=                 # optional, e.g. "tech and AI", "finance", "facts"
REEL_SECONDS=40             # target length
